[gd_resource type="Theme" load_steps=13 format=3 uid="uid://c8rpgtheme01"]

; Dark-fantasy UI theme for the Godot Web RPG.
;
; Palette is tuned against the project's clear colour, Color(0.12, 0.14, 0.18)
; declared in project.godot, so panels read as "deeper than the world" rather
; than as a different design.
;
; Assigned to the eight root Controls in scenes/main.tscn (CanvasLayer is not a
; Control and cannot carry a theme, so each root under HUD/LobbyLayer gets it).
; Themes cascade to children, so nothing below those roots needs assigning.
;
; NOTE: a scene-level theme_override_* beats this file. Semantic accents are
; deliberately left as overrides (HP bar red, XP bar gold, level label gold);
; everything structural was removed from the scene so this file governs it.

[sub_resource type="StyleBoxFlat" id="panel_dark"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.078, 0.09, 0.125, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.38, 0.32, 0.19, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 6

