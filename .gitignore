# Godot 4
.godot/
.local-runtime/
artifacts/
*-check.log
game-tests.log
bin/

# Web export output (~43MB, regenerate with tools/build_web.ps1).
# NOTE: a git-only deploy will 404 on every asset while /health still answers.
# Build on the host, or ship dist/ out of band.
dist/

# Node
node_modules/
server/node_modules/

# Runtime SQLite database (accounts, characters, inventory).
# db.js recreates server/data/ on startup, so a fresh clone is fine.
# This is live player data, NOT a fixture — back it up separately.
server/data/

# OS
Thumbs.db
.DS_Store

# Obsidian per-user state (shared config in wiki/.obsidian/ stays tracked)
wiki/.obsidian/workspace.json
